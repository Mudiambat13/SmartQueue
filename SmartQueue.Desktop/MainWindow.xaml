<Window x:Class="SmartQueue.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartQueue - Tableau de Bord Agent" Height="450" Width="700" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="SmartQueue - Guichet Agent Professionnel" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration & Actions -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Configuration du Guichet" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10"/>
                
                <TextBlock Text="Nom du Guichet :" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtCounter" Text="Guichet A" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Prochain Numéro à Appeler :" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtTicketNumber" Text="T-101" Padding="5" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <Button Content="Appeler le Ticket Suivant" Click="BtnCallNext_Click" Background="#10B981" Foreground="White" Padding="10" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Monitoring live screen simulation -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Écran Public Interactif (Live Sync)" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15"/>
                    <Border Background="#FEF3C7" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <TextBlock x:Name="LblCurrentCall" Text="En attente d'un appel..." FontSize="16" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Historique Récent :" FontSize="12" FontWeight="Bold" Foreground="#6B7280" Margin="0,10,0,5"/>
                    <ListBox x:Name="LstHistory" Height="180" Background="#F9FAFB" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Connexion au serveur ASP.NET Core..." Foreground="#6B7280"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>